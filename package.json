{
  "name": "hanif-portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "check:deploy": "node --env-file-if-exists=.env scripts/check-deploy.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node scripts/test-local.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "format": "prettier --write app src prisma/seed.ts scripts tests playwright.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "4.9.0",
    "@vercel/blob": "2.4.0",
    "bcrypt": "^6.0.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.511.0",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "pdfjs-dist": "6.5.438",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}

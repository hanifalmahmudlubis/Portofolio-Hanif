# PostgreSQL database used by the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
# Vercel: connect a Public Blob store to the deployment environment.
# BLOB_STORE_ID enables Vercel's automatic OIDC authentication.
# Outside Vercel, use BLOB_READ_WRITE_TOKEN instead. Never prefix it with NEXT_PUBLIC_.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
# Only needed when deliberately creating/updating an admin through npm run db:seed.
ADMIN_EMAIL="admin@portofolio.com"
ADMIN_PASSWORD=""
